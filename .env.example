# --- Core ---
# Postgres connection string (system of record + LangGraph checkpointer)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pm_agent

# --- LLM gateway (OpenAI-compatible endpoint, e.g. NVIDIA NIM) ---
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=changeme
LLM_MODEL=meta/llama-3.3-70b-instruct

# --- Google (Docs + Calendar share one service account JSON) ---
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json
GOOGLE_DOC_ID=your-default-transcript-doc-id
GOOGLE_CALENDAR_ID=primary

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_CHANNEL_ID=C0000000000
PM_SLACK_USER_ID=U0000000000

# --- GitHub ---
GITHUB_TOKEN=ghp_...
# owner/name
GITHUB_REPO=your-org/your-repo

# --- PostHog ---
POSTHOG_HOST=https://app.posthog.com
POSTHOG_PROJECT_ID=0
POSTHOG_PERSONAL_API_KEY=phx_...

# --- Grading / demo ---
# Absolute tolerance (percentage points) when grading a prediction vs. outcome
BET_TOLERANCE_PP=5.0
# When true, check-due-reviews ignores the clock so demos can resolve bets on demand
DEMO_MODE=false
